D+=d;T+=t;
const pc=t?Math.round(d/t*100):0;
$('#catBars').insertAdjacentHTML('beforeend',`<div class="row"><b><span>${g.icon} ${g.name}</span><span>${d}/${t}</span></b><div class="pb"><div class="pf" style="width:${pc}%">${pc}%</div></div></div>`);
});
save();
const pc=T?Math.round(D/T*100):0;
$('#allBar').style.width=pc+'%';
$('#allBar').textContent=pc+'%';
$('#allTxt').textContent=D+' dari '+T+' tugas selesai (semua kategori, periode berjalan)';

const days=[];
for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);days.push(d);}
const hv=days.map(d=>{const e=S.log['harian|'+ds(d)];return{d,pc:e&&e.t?Math.round(e.d/e.t*100):0};});
$('#chart').innerHTML=hv.map(x=>`<div title="${x.pc}%"><span>${x.pc}%</span><i style="height:${x.pc}%"></i><span>${['Min','Sen','Sel','Rab','Kam','Jum','Sab'][x.d.getDay()]}</span></div>`).join('');

let st=0;
for(let i=0;i<365;i++){
const d=new Date();d.setDate(d.getDate()-i);
const e=S.log['harian|'+ds(d)];
const ok=e&&e.t&&e.d/e.t>=.8;
if(ok){st++;}else if(i>0){break;}else{continue;}
}
const avg=Math.round(hv.reduce((a,b)=>a+b.pc,0)/7);
const entries=Object.values(S.log);
$('#stats').innerHTML=`<div class="stat"><b>${st}</b>hari streak (≥80%)</div><div class="stat"><b>${avg}%</b>rata-rata 7 hari</div><div class="stat"><b>${entries.length}</b>catatan riwayat</div>`;

const rows=entries.sort((a,b)=>b.p.localeCompare(a.p)).slice(0,60);
$('#hist').innerHTML=rows.length?rows.map(e=>`<tr><td>${e.p}</td><td>${e.g}</td><td>${e.d}/${e.t}</td><td>${e.t?Math.round(e.d/e.t*100):0}%</td></tr>`).join(''):`<tr><td colspan="4" class="muted">Belum ada riwayat. Centang tugas di tab Checklist.</td></tr>`;
}
