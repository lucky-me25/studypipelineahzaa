`<div class="stat"><b>${st}</b>hari beruntun</div>`+
`<div class="stat"><b>${top>=0?MOODS[top].e:'–'}</b>mood terbanyak</div>`;
$('#rHist').textContent=r.r?`Mood dipilih: ${MOODS[r.r-1].e} ${MOODS[r.r-1].l} (klik lagi untuk menghapus)`:'Belum ada mood untuk hari ini. Pilih emoji sesuai harimu.';
