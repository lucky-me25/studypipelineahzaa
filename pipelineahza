<title>Study Pipeline Ahza dari Kak uii ᯓᡣ𐭩</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f4f5fb;--card:#fff;--tx:#23233a;--mut:#6b6b85;--pri:#5b5bd6;--pri2:#7c4dbb;--bd:#e2e3ef;--ok:#2e9e5b;--warn:#fff4d6}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14141f;--card:#1e1e2e;--tx:#e8e8f4;--mut:#9a9ab5;--pri:#8b8bf0;--pri2:#b08be0;--bd:#33334a;--ok:#4cc27f;--warn:#3a3320}}
:root[data-theme="dark"]{--bg:#14141f;--card:#1e1e2e;--tx:#e8e8f4;--mut:#9a9ab5;--pri:#8b8bf0;--pri2:#b08be0;--bd:#33334a;--ok:#4cc27f;--warn:#3a3320}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*:before,*:after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;padding:22px 16px 14px;text-align:center}
header h1{margin:0;font-size:1.5rem}
header p{margin:4px 0 0;opacity:.9;font-size:.9rem}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;gap:6px;overflow-x:auto;padding:8px 12px;background:var(--card);border-bottom:1px solid var(--bd)}
nav button{flex:0 0 auto;border:0;background:transparent;color:var(--mut);padding:8px 14px;border-radius:20px;font:inherit;font-weight:600;cursor:pointer}
nav button.on{background:var(--pri);color:#fff}
main{max-width:900px;margin:0 auto;padding:16px}
.tab{display:none}
.tab.on{display:block}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:16px;margin-bottom:16px}
h2{color:var(--pri);margin:0 0 10px;font-size:1.25rem}
h3{color:var(--pri2);margin:18px 0 6px}
.bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
.btn{border:1px solid var(--bd);background:var(--card);color:var(--tx);padding:7px 12px;border-radius:8px;font:inherit;font-size:.9rem;cursor:pointer}
.btn.p{background:var(--pri);color:#fff;border-color:var(--pri)}
.btn.d{color:#d33}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:480px}
th,td{border:1px solid var(--bd);padding:8px 10px;text-align:left}
th{background:var(--pri);color:#fff}
.note{background:var(--warn);border-left:4px solid #e0a800;padding:10px 12px;border-radius:6px;margin:12px 0}
.editing [contenteditable],.editing{outline:none}
#guide.editing{outline:2px dashed var(--pri);outline-offset:6px;border-radius:6px}
.item{display:flex;align-items:center;gap:10px;padding:8px;border-radius:8px;border:1px solid var(--bd);margin-bottom:6px}
.item input[type=checkbox]{width:20px;height:20px;flex:0 0 auto;accent-color:var(--pri)}
.item .t{flex:1;min-width:0;outline:none;word-break:break-word}
.item.done .t{text-decoration:line-through;color:var(--mut)}
.x{border:0;background:none;color:#d33;font-size:1.1rem;cursor:pointer;padding:2px 6px}
.add{display:flex;gap:6px;margin-top:8px}
.add input,.add select{flex:1;min-width:0;padding:8px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx);font:inherit}
.add select{flex:0 0 auto}
.pb{height:22px;background:var(--bd);border-radius:11px;overflow:hidden}
.pf{height:100%;background:linear-gradient(90deg,var(--pri),var(--pri2));color:#fff;font-size:.75rem;font-weight:700;text-align:center;line-height:22px;transition:width .4s;min-width:0}
.row{margin:10px 0}
.row b{display:flex;justify-content:space-between;font-size:.9rem}
.chart{display:flex;align-items:flex-end;gap:8px;height:120px;margin-top:8px}
.chart div{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;font-size:.7rem;color:var(--mut)}
.chart i{display:block;width:100%;background:var(--pri);border-radius:4px 4px 0 0;min-height:2px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-top:12px}
.stat{background:var(--bg);border-radius:10px;padding:10px;text-align:center}
.stat b{display:block;font-size:1.5rem;color:var(--pri)}
.tag{font-size:.7rem;padding:2px 8px;border-radius:10px;background:var(--bd);color:var(--mut)}
.tag.High{background:#fde0e0;color:#b00}
.tag.Med{background:#fff0c9;color:#8a6200}
.tag.Low{background:#dff3e6;color:#1f7a45}
.bl h3{margin:0 0 6px;outline:none}
.bl ul{margin:0;padding-left:22px;outline:none;min-height:30px}
.bl{border:1px solid var(--bd);border-radius:10px;padding:12px;margin-bottom:12px}
.muted{color:var(--mut);font-size:.85rem}
@media print{nav,header,.bar,.add,.x{display:none}}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-bottom:16px}
.grid .card{margin:0}
.ring{width:120px;height:120px;border-radius:50%;background:conic-gradient(var(--pri) calc(var(--p,0)*1%),var(--bd) 0);display:grid;place-items:center;margin:auto;position:relative}
.ring:before{content:'';position:absolute;inset:10px;background:var(--card);border-radius:50%}
.ring b{position:relative;font-size:2rem}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.cal b{font-size:.75rem;color:var(--mut)}
.cal button{border:1px solid var(--bd);background:var(--bg);color:var(--tx);border-radius:8px;padding:6px 0;font:inherit;cursor:pointer;min-height:44px}
.cal button i{display:block;font-size:.6rem;font-style:normal;color:var(--pri);height:10px}
.cal .tdy{border-color:var(--pri);font-weight:700}
.cal .sel{background:var(--pri);color:#fff}
.cal .sel i{color:#fff}
.fg{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px}
.fg input,.fg select,textarea,#aiIn,#sMin,#wk{padding:8px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx);font:inherit;min-width:0}
textarea{width:100%;min-height:70px;margin-top:8px}
.em button{font-size:1.5rem;padding:4px 10px}
.em .sel{background:var(--pri);border-color:var(--pri)}
#chat{max-height:380px;overflow-y:auto;margin:10px 0}
.msg{padding:10px 12px;border-radius:12px;margin-bottom:8px;white-space:pre-wrap;word-break:break-word}
.msg.u{background:var(--pri);color:#fff;margin-left:15%}
.msg.b{background:var(--bg);border:1px solid var(--bd);margin-right:8%}
td[contenteditable]{min-width:90px;outline:none}
td[contenteditable]:focus{background:var(--warn)}
/* MOOD TRACKER */
.mood-pick{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:10px}
.mb{border:2px solid var(--bd);background:color-mix(in srgb,var(--c) 10%,var(--card));color:var(--tx);border-radius:14px;padding:8px 2px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;font:inherit;min-height:66px;transition:transform .15s,box-shadow .15s,background .15s}
.mb .me{font-size:1.9rem;line-height:1}
.mb .ml{font-size:.62rem;font-weight:600;color:var(--mut);text-align:center}
.mb:hover{transform:translateY(-3px)}
.mb.sel{border-color:var(--c);background:color-mix(in srgb,var(--c) 32%,var(--card));box-shadow:0 4px 14px color-mix(in srgb,var(--c) 45%,transparent);transform:translateY(-3px) scale(1.06)}
.mb.sel .ml{color:var(--tx)}
.mcal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.mcal b{font-size:.7rem;color:var(--mut)}
.mc{border:1px solid var(--bd);background:var(--bg);color:var(--tx);border-radius:10px;font:inherit;cursor:pointer;min-height:46px;padding:2px 0;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.1}
.mc small{font-size:.6rem;color:var(--mut)}
.mc span{font-size:1.15rem;min-height:1.2em}
.mc.has{background:color-mix(in srgb,var(--c) 28%,var(--card));border-color:var(--c)}
.mc.tdy{outline:2px solid var(--pri);outline-offset:1px}
.mc.sel{box-shadow:0 0 0 3px var(--pri)}
.mc:disabled{opacity:.35;cursor:default}
.md{display:flex;align-items:center;gap:8px;margin:4px 0;font-size:.85rem}
.mt{flex:1;height:12px;background:var(--bd);border-radius:6px;overflow:hidden}
.mt i{display:block;height:100%;border-radius:6px;transition:width .4s}
.md b{width:22px;text-align:right}
/* AI ASSISTANT */
.aiw-b{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));width:56px;height:56px;border-radius:50%;border:0;background:linear-gradient(135deg,#5b5bd6,#7c4dbb);color:#fff;font-size:26px;cursor:pointer;box-shadow:0 4px 14px #0004;z-index:99998}
.aiw-p{position:fixed;right:16px;bottom:calc(84px + env(safe-area-inset-bottom,0px));width:min(380px,calc(100vw - 32px));height:min(520px,70vh);display:none;flex-direction:column;background:#fff;color:#23233a;border:1px solid #e2e3ef;border-radius:14px;box-shadow:0 8px 30px #0004;z-index:99999;overflow:hidden;font:15px/1.5 system-ui,sans-serif}
.aiw-p.on{display:flex}
.aiw-h{background:linear-gradient(135deg,#5b5bd6,#7c4dbb);color:#fff;padding:12px 14px;font-weight:700;display:flex;justify-content:space-between}
.aiw-h button{background:none;border:0;color:#fff;font-size:18px;cursor:pointer}
.aiw-m{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:8px;background:#f4f5fb}
.aiw-g{padding:10px 12px;border-radius:12px;white-space:pre-wrap;word-break:break-word;max-width:88%}
.aiw-g.u{background:#5b5bd6;color:#fff;align-self:flex-end}
.aiw-g.b{background:#fff;border:1px solid #e2e3ef;align-self:flex-start}
.aiw-q{display:flex;gap:6px;overflow-x:auto;padding:6px 10px;background:#f4f5fb}
.aiw-q button{flex:0 0 auto;border:1px solid #e2e3ef;background:#fff;color:#23233a;border-radius:16px;padding:5px 10px;font-size:12px;cursor:pointer}
.aiw-f{display:flex;gap:6px;padding:8px;border-top:1px solid #e2e3ef;background:#fff}
.aiw-f input{flex:1;min-width:0;padding:9px 10px;border:1px solid #e2e3ef;border-radius:8px;font:inherit;background:#fff;color:#23233a}
.aiw-f button{border:0;background:#5b5bd6;color:#fff;border-radius:8px;padding:0 14px;font:inherit;cursor:pointer}
@media print{.aiw-b,.aiw-p{display:none!important}}
</style>
</head>
