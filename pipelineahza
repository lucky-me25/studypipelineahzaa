const mx=Math.max(1,...cnt);
$('#mDist').innerHTML=MOODS.map((m,i)=>`<div class="md"><span>${m.e}</span><div class="mt"><i style="width:${cnt[i]/mx*100}%;background:${m.c}"></i></div><b>${cnt[i]}</b></div>`).join('');

const w=last(7);
$('#mTrend').innerHTML=w.map(k=>{
const v=(S.rate[k]&&S.rate[k].r)||0,m=v?MOODS[v-1]:null;
return `<div title="${m?m.l:'Belum diisi'}"><span>${m?m.e:'·'}</span><i style="height:${v*20}%;${m?'background:'+m.c:'opacity:.25'}"></i><span>${DN[new Date(k+'T00:00').getDay()]}</span></div>`;
}).join('');

