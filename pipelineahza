/* AI ASSISTANT */
(function(){
const EP=AI_ENDPOINT;
const TITLE='AI Study Assistant';
const HELLO='Halo Ahza! Tanyakan konsep pelajaran, minta soal latihan, atau evaluasi rencana belajarmu.';

const st=document.createElement('style');
st.textContent=`
.aiw-p.ai-dark{background:#1e1e2e;color:#e8e8f4;border-color:#33334a}
.aiw-p.ai-dark .aiw-m,.aiw-p.ai-dark .aiw-q{background:#14141f}
.aiw-p.ai-dark .aiw-g.b,.aiw-p.ai-dark .aiw-q button{background:#1e1e2e;color:#e8e8f4;border-color:#33334a}
.aiw-p.ai-dark .aiw-f{background:#1e1e2e;border-color:#33334a}
.aiw-p.ai-dark .aiw-f input{background:#14141f;color:#e8e8f4;border-color:#33334a}`;
document.head.appendChild(st);

const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x)e.textContent=x;return e;};

const btn=el('button','aiw-b','𑄝੭');
btn.setAttribute('aria-label','Buka AI Assistant');
const p=el('div','aiw-p');
const h=el('div','aiw-h');
h.append(el('span','','🤖 '+TITLE));
const cl=el('button','','✕');
h.append(cl);
const m=el('div','aiw-m');
const q=el('div','aiw-q');
const f=el('form','aiw-f');
const inp=el('input');
const go=el('button','','Kirim');
inp.placeholder='Tanya apa saja…';
go.type='submit';
f.append(inp,go);
p.append(h,m,q,f);
document.body.append(btn,p);

const hist=[];
const add=(c,t)=>{const d=el('div','aiw-g '+c,t);m.append(d);m.scrollTop=1e9;return d;};
add('b',HELLO);

['Rencana belajar hari ini','Beri 5 soal latihan','Evaluasi progres saya','Tips menghadapi ujian'].forEach(t=>{
const b=el('button','',t);
b.type='button';
b.onclick=()=>{send(t);};
q.append(b);
});

let busy=false;

/* Terjemahkan error teknis jadi pesan yang bisa ditindaklanjuti */
function friendlyError(e,status){
const msg=(e&&e.message)||'Unknown error';
if(e&&e.name==='AbortError'){
return 'Server AI terlalu lama merespons (lebih dari 40 detik). Coba kirim lagi sebentar lagi.';
}
if(e instanceof TypeError||/failed to fetch|networkerror|load failed/i.test(msg)){
return 'Tidak bisa terhubung ke server AI.\n\n'+
'Kemungkinan penyebab:\n'+
'• Internet sedang putus\n'+
'• Cloudflare Worker belum di-deploy atau URL-nya salah\n'+
'• Worker belum mengizinkan CORS (balasan OPTIONS)\n'+
'• Worker crash karena ANTHROPIC_API_KEY belum diisi\n\n'+
'Detail teknis: '+msg;
}
if(status===401||status===403)return 'API key ditolak. Cek ANTHROPIC_API_KEY di Worker.\n\n'+msg;
if(status===429)return 'Terlalu banyak permintaan. Tunggu sebentar lalu coba lagi.\n\n'+msg;
return 'Maaf, AI belum bisa menjawab.\n\n'+msg;
}

async function send(text){
text=(text||'').trim();
if(!text||busy)return;
busy=true;
inp.value='';
add('u',text);

if(!EP){
add('b','Asisten AI belum terhubung ke Cloudflare Worker.');
busy=false;
return;
}

hist.push({role:'user',content:text});
const out=add('b','Berpikir…');

const ctrl=new AbortController();
const timer=setTimeout(()=>ctrl.abort(),40000);
let status=0;

try{
const r=await fetch(EP,{
method:'POST',
headers:{'Content-Type':'application/json'},
body:JSON.stringify({messages:hist.slice(-10),context:window.AIWidgetContext()}),
signal:ctrl.signal
});
status=r.status;
const d=await r.json().catch(()=>({}));
if(!r.ok){
throw new Error(d.details||d.error||('HTTP '+r.status));
}
const reply=d.reply||'(AI tidak mengembalikan jawaban.)';
out.textContent=reply;
hist.push({role:'assistant',content:reply});
}catch(e){
console.error('AI Worker Error:',e);
out.textContent=friendlyError(e,status);
hist.pop();
}finally{
clearTimeout(timer);
}

busy=false;
m.scrollTop=1e9;
}

f.onsubmit=e=>{e.preventDefault();send(inp.value);};
const tog=()=>{p.classList.toggle('on');if(p.classList.contains('on'))inp.focus();};
btn.onclick=tog;
cl.onclick=tog;
window.AIWidget={open:()=>{p.classList.add('on');inp.focus();},send};
})();

/* START APP */
renderAll();
</script>
